# Graviton — Environment Variables
# Copy to .env and fill in values

# AIS Stream (ship tracking) — get key at https://aisstream.io
AIS_API_KEY=

# OpenSky Network (enhanced flight data) — register at https://opensky-network.org
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Admin key for settings endpoints (optional, leave empty for open access)
ADMIN_KEY=

# CORS origins (comma-separated, optional)
# CORS_ORIGINS=http://localhost:3000,https://myserver.com
